<?xml version="1.0" encoding="utf-8"?>
<!--
  Albums and tags move with you to a new phone (device-to-device transfer, local only).
  Nothing goes to cloud backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="locket.db" />
        <include domain="sharedpref" path="locket.xml" />
    </device-transfer>
</data-extraction-rules>
